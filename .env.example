# 复制为 .env 后填写真实值：copy .env.example .env
# 切勿把 .env 提交到 Git

# ========== 运行模式 ==========
# local | production 等（按你业务约定）
AGENT_RUN_MODE=local
APP_NAME=Agents

# ========== 认证 JWT ==========
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# 注册默认归属（需库中存在对应 id，或不跑 seed 时先手工插入 unit/role=1）
DEFAULT_UNIT_ID=1
# 注册默认角色：4=viewer（最低）；1=admin
DEFAULT_ROLE_ID=4

# ========== MySQL / TDSQL ==========
TDSQL_HOST=127.0.0.1
TDSQL_PORT=3306
TDSQL_USER=root
TDSQL_PASSWORD=
TDSQL_DB=agent

# ========== Redis / Celery ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0
# 空则回落 REDIS_URL
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ========== DB 池（须低于云库 max_connections 并留余量）==========
DB_POOL_MAXSIZE=8
DB_THREAD_WORKERS=12
CELERY_DB_POOL_MAXSIZE=4

# ========== Milvus ==========
MILVUS_ENABLED=true
MILVUS_MODE=lite
MILVUS_LITE_PATH=./db/milvus_lite.db
# MILVUS_HOST=127.0.0.1
# MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=kb_document_vectors
MILVUS_MEMORY_COLLECTION_NAME=user_memory_vectors
MILVUS_EMBEDDING_DIM=1024
EMBEDDING_VERSION=v1
ADMIN_ROLE_ID=1

# ========== 通义 / DashScope ==========
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_COMPATIBLE_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
DASHSCOPE_CHAT_MODEL=qwen-vl-max
DASHSCOPE_ANSWER_MODEL=
DASHSCOPE_FAST_MODEL=qwen-turbo
DASHSCOPE_STRONG_MODEL=qwen-plus
DASHSCOPE_JUDGE_MODEL=
DASHSCOPE_TIMEOUT_SEC=90
# 可选降级厂商
# ZHIPU_API_KEY=
# ZHIPU_COMPATIBLE_BASE=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_FAST_MODEL=glm-4-flash
# ZHIPU_STRONG_MODEL=glm-4

# ========== 阿里云短信（可选）==========
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ========== 上传 ==========
UPLOAD_DIRECTORY=./uploads
UPLOAD_MAX_FILE_SIZE=52428800
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.txt,.md,.docx

# ========== 文档解析 ==========
UNSTRUCTURED_PDF_STRATEGY=hi_res
UNSTRUCTURED_OCR_LANGUAGES=chi_sim+eng
CHUNK_MAX_CHARACTERS=1000
CHUNK_NEW_AFTER_N_CHARS=800
CHUNK_COMBINE_TEXT_UNDER_N_CHARS=200
CHUNK_OVERLAP=100
CHUNK_OVERLAP_ALL=false

# ========== 检索 / RAG ==========
RETRIEVE_TOP_K_PER_PATH=8
ANSWER_TOP_K=5
QUERY_EXPAND_N=3
BM25_CANDIDATE_LIMIT=50
BM25_USE_JIEBA=true
RRF_K=60
RRF_PER_QUERY=10
RRF_FINAL=20
RRF_VECTOR_WEIGHT=0.4
RRF_BM25_WEIGHT=0.6
RERANK_ENABLED=false
RERANK_MODEL=
RERANK_MAX_DOC_CHARS=2000
MAX_CONTEXT_TOKENS=20000
MAX_CONTEXT_TURNS=3
CONTEXT_CACHE_TTL=1800
# unit 级 QA 答案缓存
RAG_QA_CACHE_ENABLED=true
RAG_QA_CACHE_TTL=3600
# 用户长期记忆（默认开）
USER_MEMORY_ENABLED=true
USER_MEMORY_EXTRACT_EVERY_N=3
USER_MEMORY_MAX_PER_USER=50
USER_MEMORY_TOP_M=5
LLM_ENHANCE_MODE=off
LLM_ENHANCE_MAX_IMAGES=0

# ========== LangSmith（必做，评测/问答链路）==========
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agents

# ========== 本地 rag_trace / OTel（无 Docker 可不配 OTLP）==========
RAG_TRACE_ENABLED=true
RAG_TRACE_FULL=false
RAG_TRACE_DIR=logs
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_SERVICE_NAME=agents-server

# ========== 可选第三方（旅行/搜索；只读环境变量，不进 Settings）==========
AMAP_KEY=
AMAP_API_BASE=https://restapi.amap.com
QWEATHER_KEY=
QWEATHER_HOST=
BOCHA_API_KEY=
BOCHA_API_BASE=https://api.bochaai.com
# 道旅 RollingGo MCP（酒店）；Bearer = DUTU_API_KEY（兼容旧名 DOUR_API_KEY）
DUTU_API_KEY=
DOUR_API_KEY=
DIDA_MCP_URL=https://mcp.rollinggo.cn/mcp
DEFAULT_HOTEL_TIER=comfort
STAY_HOTEL_SEARCH_RADIUS=3000
TRAVEL_HTTP_TIMEOUT=20
AGENT_WEB_SEARCH_DEFAULT_COUNT=5
AGENT_WEB_SEARCH_SNIPPET_MAX=5
AGENT_WEB_SEARCH_SUMMARY_CHARS=500
HF_ENDPOINT=
